    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "chrono-node": "^2.10.3",
    "domhandler": "^6.0.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "openai": "^7.55.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
