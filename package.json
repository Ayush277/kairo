{
  "name": "kairo",
  "version": "1.0.0",
  "description": "Kairo: a single-tool (web_search) chat agent with a temporal episodic memory engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
