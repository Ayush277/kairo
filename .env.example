# LLM Provider (Provide at least one: Anthropic is used by default if present, otherwise OpenAI)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional Model Override (defaults to claude-sonnet-4-5 or gpt-4o)
LLM_MODEL=
# Optional cheap model for background fact extraction (defaults to claude-haiku-4-5 or gpt-4o-mini)
LLM_FAST_MODEL=

# Web Search Provider (Provide at least one: Tavily recommended, Serper or Exa also supported)
# With no key at all, Kairo falls back to DuckDuckGo HTML search + Jina Reader.
TAVILY_API_KEY=tvly-...
SERPER_API_KEY=
EXA_API_KEY=

# Speculative prefetch: run the live check before the model starts when memory already names the entities.
# Set to "off" to compare latency without it.
KAIRO_PREFETCH=on

# Server Configuration
PORT=3000
